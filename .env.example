# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI APIs
GEMINI_API_KEY=
# Optional: multiple Gemini keys from SEPARATE Cloud projects (comma-separated).
# Quotas are per-project, so extra keys rotate in automatically on 429.
GEMINI_API_KEYS=
GROQ_API_KEY=
# Optional: OpenRouter as an extra reasoning fallback (Groq -> OpenRouter -> Gemini)
OPENROUTER_API_KEY=
# Optional: override the default free model (meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_MODEL=

# Nutrition API (optional)
USDA_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Serwist (suppress Turbopack incompatibility warning)
SERWIST_SUPPRESS_TURBOPACK_WARNING=1
